	</strictClockBranchRates>
	
	<!-- asymmetric BASTA model for discrete state reconstructions                -->
	<complexSubstitutionModel id="locations.model" randomizeIndicator="false" normalized="true" scaleRatesByFrequencies="false">
		<generalDataType idref="locations.dataType"/>
		<frequencies>
			<frequencyModel id="locations.frequencyModel" normalize="true">
				<generalDataType idref="locations.dataType"/>
				<frequencies>
					<parameter id="locations.frequencies" value="1.0" dimension="80"/>
				</frequencies>
			</frequencyModel>
		</frequencies>

		<!-- rates                                                   -->
		<rates>
			<parameter id="locations.rates" dimension="6320" value="1.0"/>
		</rates>
	</complexSubstitutionModel>
	
	<siteModel id="locations.siteModel">
		<substitutionModel>
			<complexSubstitutionModel idref="locations.model"/>
		</substitutionModel>
	</siteModel>
	

	<!-- <structuredCoalescent type="BASTA" id="locations.treeLikelihood" stateTagName="locations.states" useAmbiguities="true" gradientImplementation="adjoint"> -->
	<structuredCoalescent type="BASTA" id="locations.treeLikelihood" stateTagName="locations.states" useAmbiguities="true" gradientImplementation="adjoint">
		<attributePatterns idref="locations.pattern"/>
		<treeModel idref="treeModel"/>
		<siteModel idref="locations.siteModel"/>
		<complexSubstitutionModel idref="locations.model"/>
		<strictClockBranchRates idref="locations.branchRates"/>
		<popSizes>
			<parameter id="structured.popSizes" dimension="1" value="1.0" lower="0.0"/>
		</popSizes>
	</structuredCoalescent>


    <structuredCoalescentLikelihoodGradient id="gradient.1" wrtParameter="migrationRate" >
        <structuredCoalescent idref="locations.treeLikelihood"/>
        <glmSubstitutionModel idref="locations.model"/>
    </structuredCoalescentLikelihoodGradient>

    <structuredCoalescentLikelihoodGradient id="gradient.2" wrtParameter="populationSize" >
        <structuredCoalescent idref="locations.treeLikelihood"/>
        <glmSubstitutionModel idref="locations.model"/>
    </structuredCoalescentLikelihoodGradient>
	<!-- END Discrete Traits Model                                               -->

	<!-- END Discrete Traits Model                                               -->
    <!-- <gammaPrior id="locations.rates.prior" shape="1.0" scale="1.0" offset="0.0">
        <parameter idref="locations.rates"/>
    </gammaPrior> -->

    <compoundGradient id="grad.sca.likelihood">
        <structuredCoalescentLikelihoodGradient idref="gradient.1"/>
        <structuredCoalescentLikelihoodGradient idref="gradient.2"/>
    </compoundGradient>

	<distributionLikelihood id="rate.hpm">
		<data>
			<parameter idref="locations.rates"/>
		</data>
		<distribution>
			<logNormalDistributionModel id="rate.model">
				<mu>
					<parameter id="rate.mu" value="0.0" lower="-Infinity" upper="Infinity"/>
				</mu>
				<precision>
					<parameter id="rate.precision" value="1" lower="0.0" upper="Infinity"/>
				</precision>
			</logNormalDistributionModel>
		</distribution>
	</distributionLikelihood>

	<!-- <distributionLikelihood id="popsize.hpm">
		<data>
			<parameter idref="structured.popSizes"/>
		</data>
		<distribution>
			<logNormalDistributionModel id="popsize.model">
				<mu>
					<parameter id="popsize.mu" value="0.0" lower="-Infinity" upper="Infinity"/>
				</mu>
				<precision>
					<parameter id="popsize.precision" value="5.0" lower="0.0" upper="Infinity"/>
				</precision>
			</logNormalDistributionModel>
		</distribution>
	</distributionLikelihood>
	
	<normalPrior id="popsize.prior.mu" mean="0.0" stdev="100.0">
		<parameter idref="popsize.mu"/>
	</normalPrior> -->

	<gammaPrior id="popsize.prior" shape="0.001" scale="1000.0" offset="0.0">
		<parameter idref="structured.popSizes"/>
	</gammaPrior>

    <compoundGradient id="grad.sca.prior">
        <gradient>
           <distributionLikelihood idref="rate.hpm"/>
           <parameter idref="locations.rates"/>
        </gradient>
		<gradient>
		   <gammaPrior idref="popsize.prior"/>
		   <parameter idref="structured.popSizes"/>
		</gradient>
        <!-- <gradient>
           <distributionLikelihood idref="popsize.hpm"/>
           <parameter idref="structured.popSizes"/>
        </gradient> -->
    </compoundGradient>

	<!-- Define operators                                                         -->
	<operators id="operators" optimizationSchedule="log">
       <!-- <scaleOperator scaleFactor="0.75" weight="1">
			<parameter idref="locations.clock.rate"/>
		</scaleOperator> -->
		<!-- <scaleOperator scaleFactor="0.75" weight="1">
			<parameter idref="locations.clock.rate"/>
		</scaleOperator> -->
		<hamiltonianMonteCarloOperator weight="1" nSteps="3" stepSize="0.1" mode="vanilla"
									   drawVariance="1.0" autoOptimize="true" targetAcceptanceProbability="0.7"
									   gradientCheckCount="0"
									   preconditioning="none">
			<jointGradient>
				<!-- <gradient>
					<distributionLikelihood idref="popsize.hpm"/>
					<parameter idref="structured.popSizes"/>
				</gradient> -->
				<compoundGradient idref="grad.sca.likelihood"/>
				<compoundGradient idref="grad.sca.prior"/>
				<!--  <structuredCoalescentLikelihoodGradient idref="gradient.2"/> -->
			</jointGradient>
		    <multivariateCompoundTransform>
                <transform type="log" dim="6321"/>
            </multivariateCompoundTransform>
		</hamiltonianMonteCarloOperator>
		<!-- <normalNormalMeanGibbsOperator weight="1">
			<likelihood>
				<distribution idref="popsize.hpm"/>
			</likelihood>
			<prior>
				<normalPrior idref="popsize.prior.mu"/>
			</prior>
		</normalNormalMeanGibbsOperator> -->
        <!-- <scaleOperator scaleFactor="0.75" weight="1" autoOptimize="true">
            <parameter idref="locations.rates"/>
        </scaleOperator>
		<scaleOperator scaleFactor="0.75" weight="1">
			<parameter idref="structured.popSizes"/>
		</scaleOperator> -->
		<!-- <subtreeLeap size="1.0" weight="90">
			<treeModel idref="treeModel"/>
		</subtreeLeap>
		<fixedHeightSubtreePruneRegraft weight="9">
			<treeModel idref="treeModel"/>
		</fixedHeightSubtreePruneRegraft> -->
		

	</operators>

	<!-- Define MCMC                                                             -->
	<mcmc id="mcmc" chainLength="200" autoOptimize="true" operatorAnalysis="const_K080_n0250.ops">
		<posterior id="posterior">
			<prior id="prior">
				<!-- <gammaPrior shape="1.0" scale="1.0" offset="0.0">
					<parameter idref="locations.clock.rate"/>
				</gammaPrior> -->
				<distributionLikelihood idref="rate.hpm"/> 
				<gammaPrior idref="popsize.prior"/>
				<!-- <distributionLikelihood idref="popsize.hpm"/> 
				<normalPrior idref="popsize.prior.mu"/>  -->
				<!-- <gammaPrior shape="0.001" scale="1000.0" offset="0.0">
					<parameter idref="structured.popSizes"/>
				</gammaPrior> -->
				<strictClockBranchRates idref="locations.branchRates"/>
				
				<!-- <uniformPrior lower="0.0" upper="1.0">
					<parameter idref="location.root.frequencies"/>
				</uniformPrior> -->
			</prior>
			<likelihood id="likelihood">                             
				<structuredCoalescent idref="locations.treeLikelihood"/>
			</likelihood>
		</posterior>
		<operators idref="operators"/>

		<!-- write log to screen                                                     -->
		<log id="screenLog" logEvery="100">
			<column label="Posterior" dp="4" width="12">
				<posterior idref="posterior"/>
			</column>
			<column label="Prior" dp="4" width="12">
				<prior idref="prior"/>
			</column>
			<column label="Likelihood" dp="4" width="12">
				<likelihood idref="likelihood"/>
			</column>
			<column label="age(root)" sf="6" width="12">
				<tmrcaStatistic idref="age(root)"/>
			</column>
		</log>

		<!-- write log to file                                                       -->
		<log id="fileLog" logEvery="200" fileName="const_K080_n0250.log" overwrite="false">
			<posterior idref="posterior"/>
			<prior idref="prior"/>
			<likelihood idref="likelihood"/>
			<treeHeightStatistic idref="rootHeight"/>
			<tmrcaStatistic idref="age(root)"/>
			<treeLengthStatistic idref="treeLength"/>
			<parameter idref="locations.clock.rate"/>
			<parameter idref="rate.mu"/>
			<parameter idref="rate.precision"/>
			<distributionLikelihood idref="rate.hpm"/>
			<!-- <parameter idref="popsize.mu"/>
			<parameter idref="popsize.precision"/>
			<distributionLikelihood idref="popsize.hpm"/>
			<normalPrior idref="popsize.prior.mu"/>  -->
			<!-- START Discrete Traits Model                                             -->
			<parameter idref="structured.popSizes"/>
			<parameter idref="locations.rates"/>




			<!-- END Discrete Traits Model                                               -->


			<!-- START Discrete Traits Model                                             -->
			<structuredCoalescent idref="locations.treeLikelihood"/>
			<strictClockBranchRates idref="locations.branchRates"/>
			<!-- END Discrete Traits Model                                               -->
		</log>


		<!-- write tree log to file                                                  -->
		<!-- <logTree id="treeFileLog" logEvery="10000" nexusFormat="true" fileName="1003_denv1cluster_final_BASTA.trees" sortTranslationTable="true">
			<treeModel idref="treeModel"/>
			<discretizedBranchRates idref="denv1cluster.branchRates"/>
			<posterior idref="posterior"/>
			<structuredCoalescent idref="locations.treeLikelihood"/>
		</logTree> -->
	</mcmc>
	
	<report>
		<property name="timer">
			<mcmc idref="mcmc"/>
		</property>
	</report>
	
</beast>
